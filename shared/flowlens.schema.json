{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlens.dev/schemas/flowlens.schema.json",
  "title": "FlowLens Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "issue",
    "analysis",
    "flows"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "summary"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "description",
          "entryNodeIds",
          "nodes",
          "edges"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "original",
              "suggestion"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "entryNodeIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/node"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/edge"
            }
          },
          "basedOnFlowId": {
            "type": "string",
            "minLength": 1
          },
          "conclusion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "summary",
              "evidence"
            ],
            "properties": {
              "level": {
                "enum": [
                  "inconclusive",
                  "potential_issues",
                  "likely_root_cause",
                  "confirmed_mismatch"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "nodeId"
                  ],
                  "properties": {
                    "nodeId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "remainingQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "startLine",
        "endLine"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "codeLine": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "codeBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lines"
          ],
          "properties": {
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/codeLine"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "omitted"
          ],
          "properties": {
            "omitted": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "startLine",
                "endLine",
                "summary"
              ],
              "properties": {
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "explanation",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "status": {
          "enum": [
            "suspected",
            "supported",
            "confirmed"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/range"
          }
        },
        "suggestion": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "start",
            "end",
            "operation",
            "decision",
            "retry",
            "error"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "symbol",
            "startLine",
            "endLine"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codeBlock"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "branch",
            "retry",
            "async"
          ]
        }
      }
    }
  }
}
